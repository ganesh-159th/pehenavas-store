VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Backend server URL (default http://localhost:4000)
VITE_API_URL=http://localhost:3001/api

# Razorpay (get test keys from dashboard.razorpay.com)
# Public key ID — safe to expose to the browser (used by Razorpay Checkout)
VITE_RAZORPAY_KEY_ID=
# Server-side key secret — NEVER expose this to the browser (used to create
# orders and verify payment signatures). Leave RAZORPAY_KEY_ID unset unless
# you don't want to share the key between frontend and server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (Gmail SMTP — use App Password, not your real password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=your-email@gmail.com
APP_URL=http://localhost:3000

# Server-side Firebase admin user (create in Firebase Console > Authentication > Add user)
FIREBASE_ADMIN_EMAIL=admin@example.com
FIREBASE_ADMIN_PASSWORD=your-admin-password

# Firebase Admin SDK service account (base64-encoded JSON key)
# Generate with: base64 -i pehenavas-db-firebase-adminsdk-*.json
FIREBASE_SERVICE_ACCOUNT_B64=

# Reviews: max reviews per user per hour (default 5)
MAX_REVIEWS_PER_HOUR=5
